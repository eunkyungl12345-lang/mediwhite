# Supabase 프로젝트 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 서버 전용, 절대 공개 금지

# 세션 쿠키 서명용 긴 랜덤 문자열 (32자 이상)
SESSION_SECRET=change-me-to-a-long-random-string

# 관리자 아이디 (쉼표로 여러 개). 이 아이디로 가입하면 관리자 권한(상단 고정, 글 삭제)
ADMIN_USERNAMES=admin

# 배포 도메인. 비우면 요청이 들어온 주소(origin)를 그대로 씁니다. 예: https://mediwhite.vercel.app
# 소셜 로그인 리다이렉트 주소도 이 값을 기준으로 만들어집니다.
NEXT_PUBLIC_APP_URL=

# ── 소셜 간편 로그인 (카카오·네이버·구글) ─────────────────────────────
# 안 쓰는 제공자는 비워 두세요. 키가 없는 제공자의 버튼은 /login?error=<provider>_config 로 안내됩니다.

# 카카오: developers.kakao.com > 내 애플리케이션 > 앱 키(REST API 키) / 보안
# Redirect URI: {도메인}/api/auth/callback/kakao
KAKAO_CLIENT_ID=
# 카카오 앱에서 '보안 > Client Secret' 사용을 켠 경우에만 채우세요 (비우면 전송하지 않음)
KAKAO_CLIENT_SECRET=

# 네이버: developers.naver.com > 내 애플리케이션 > 인증 정보 (Client Secret은 필수)
# Redirect URI: {도메인}/api/auth/callback/naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 (OAuth 2.0 클라이언트 ID)
# 승인된 리디렉션 URI: {도메인}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
