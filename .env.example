# Supabase 프로젝트 > Settings > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 서버 전용, 절대 공개 금지

# 세션 쿠키 서명용 긴 랜덤 문자열 (32자 이상)
SESSION_SECRET=change-me-to-a-long-random-string

# 관리자 아이디 (쉼표로 여러 개). 이 아이디로 가입하면 관리자 권한(상단 고정, 글 삭제)
ADMIN_USERNAMES=admin

# 카카오 간편 로그인 (developers.kakao.com > 내 애플리케이션 > 앱 키 / 보안)
# REST API 키를 KAKAO_CLIENT_ID 에 넣습니다. Redirect URI: {도메인}/api/auth/callback/kakao
KAKAO_CLIENT_ID=
# 카카오 앱에서 '보안 > Client Secret' 사용을 켠 경우에만 채우세요 (비우면 전송하지 않음)
KAKAO_CLIENT_SECRET=
# 배포 도메인. 비우면 요청이 들어온 주소(origin)를 그대로 씁니다. 예: https://mediwhite.vercel.app
NEXT_PUBLIC_APP_URL=
